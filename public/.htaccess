# Enable URL rewriting for clean URLs, redirecting requests to `index.php` with the path as a query parameter.
# Excludes existing files and directories. Case-insensitive and preserves query strings.

RewriteEngine on
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.php?path=$1 [NC,L,QSA]
